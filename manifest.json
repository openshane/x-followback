{
  "manifest_version": 3,
  "name": "𝕏 回关助手",
  "version": "1.2.2",
  "description": "找出关注了你、你还没回关的 X 认证账号。可筛选蓝 V、搜索名单、导出 CSV，并比较两次完整扫描中新出现的待回关账号。名单按账号保存在本机。",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "sidePanel",
    "scripting"
  ],
  "host_permissions": [
    "https://x.com/*"
  ],
  "action": {
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "𝕏 回关助手"
  },
  "background": {
    "service_worker": "worker.js"
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://x.com/*/verified_followers*"
      ],
      "js": [
        "capture.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://x.com/*/verified_followers*"
      ],
      "js": [
        "identity.js",
        "reader.js"
      ],
      "run_at": "document_start"
    }
  ]
}
